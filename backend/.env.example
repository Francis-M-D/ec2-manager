EC2MANAGER_DB_CONNECTION=Server=mysql;Port=3306;Database=ec2manager;User=root;Password=root;
EC2MANAGER_JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
EC2MANAGER_CLOUD_SERVICE_URL=http://cloud-service:8001
EC2MANAGER_INTERNAL_API_KEY=change-me-shared-secret
EC2MANAGER_FRONTEND_ORIGIN=http://localhost:5173

# Must match cloud-service's values exactly (both services decrypt the same blob)
EC2MANAGER_DECRYPTION_KEY=
EC2MANAGER_AWS_ACCOUNTS_ENCRYPTED=
